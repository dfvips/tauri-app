{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "音乐解锁 - Unlock Music",
  "version": "0.6.0",
  "identifier": "com.yoka.sgstenth",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "音乐解锁 - Unlock Music",
        "width": 1280,
        "height": 720,
        "backgroundColor": "#000000",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../app.config.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MengYX"
  }
}
